from typing import Any, Callable, ContextManager, TextIO, Literal, NoReturn, TypedDict

class Expr:
    source: str
    def __bool__(self) -> NoReturn: ...
    def __and__(self, other: Expr) -> Expr: ...
    def __or__(self, other: Expr) -> Expr: ...
    def __invert__(self) -> Expr: ...

class _Comparable(Expr):
    # Comparisons construct runtime expressions; never use them in Python if.
    def __eq__(self, other: Any) -> Any: ...
    def __ne__(self, other: Any) -> Any: ...
    def __lt__(self, other: Any) -> Expr: ...
    def __le__(self, other: Any) -> Expr: ...
    def __gt__(self, other: Any) -> Expr: ...
    def __ge__(self, other: Any) -> Expr: ...

class _StrCall(_Comparable): ...

class Ref(_Comparable):
    def __getitem__(self, key: str | int) -> Ref: ...
    def __getattr__(self, key: str) -> Ref: ...

_Text = Ref | _StrCall | str

# String helpers for when/fail_if/filter expressions (strings only at run time).
def lower(s: _Text) -> _StrCall: ...
def upper(s: _Text) -> _StrCall: ...
def trim(s: _Text) -> _StrCall: ...
def contains(haystack: _Text, needle: _Text) -> Expr: ...
def starts_with(s: _Text, prefix: _Text) -> Expr: ...
def ends_with(s: _Text, suffix: _Text) -> Expr: ...

class Type:
    definition: dict[str, Any]
    def __call__(self, *, min: int | float = ..., max: int | float = ...,
                 min_items: int = ..., max_items: int = ..., min_length: int = ...,
                 max_length: int = ..., enum: list[Any] = ..., description: str = ...,
                 default: Any = ...) -> Type: ...
    def __getitem__(self, item: Type | dict[str, Any]) -> Type: ...

Str: Type
Int: Type
Number: Type
Bool: Type
List: Type

def Object(fields: dict[str, Type | dict[str, Any]] | None = ..., *, closed: bool = ...) -> Type: ...

class _Data:
    def parse_json(self, text: Any, *, schema: Type | dict[str, Any] = ..., id: str | None = ...) -> Ref: ...
    def project(self, value: Any, fields: Any, *, id: str | None = ...) -> Ref: ...
    def count(self, value: Any, *, id: str | None = ...) -> Ref: ...
    def sum_integers(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def get(self, value: Any, path: Any, *, default: Any = ..., id: str | None = ...) -> Ref: ...
    def keys(self, value: Any, *, id: str | None = ...) -> Ref: ...
    def concat(self, left: Any, right: Any, *, id: str | None = ...) -> Ref: ...
    def slice(self, values: Any, start: Any, end: Any, *, id: str | None = ...) -> Ref: ...
    def sort(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def unique(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def trim(self, text: Any, *, id: str | None = ...) -> Ref: ...
    def split(self, text: Any, separator: Any, *, id: str | None = ...) -> Ref: ...
    def join(self, values: Any, separator: Any, *, id: str | None = ...) -> Ref: ...
    def replace(self, text: Any, old: Any, new: Any, /, *, id: str | None = ...) -> Ref: ...
    def arithmetic(self, left: Any, right: Any, operator: Literal['add','subtract','multiply','divide','remainder'], *, id: str | None = ...) -> Ref: ...
    def compare(self, left: Any, right: Any, operator: Literal['eq','ne','lt','le','gt','ge'], *, id: str | None = ...) -> Ref: ...
    def assert_(self, condition: Any, *, message: str = ..., id: str | None = ...) -> Ref: ...
    def all(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def any(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def logic(self, operator: Any, left: Any, right: Any = ..., *, id: str | None = ...) -> Ref: ...
    def select(self, condition: Any, then: Any, else_: Any, /, *, id: str | None = ...) -> Ref: ...
    def min(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def max(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def clamp(self, value: Any, min: Any, max: Any, *, id: str | None = ...) -> Ref: ...
    def abs(self, value: Any, *, id: str | None = ...) -> Ref: ...
    def merge(self, left: Any, right: Any, *, id: str | None = ...) -> Ref: ...
    def set(self, value: Any, field: Any, item: Any, *, id: str | None = ...) -> Ref: ...
    def omit(self, value: Any, fields: Any, *, id: str | None = ...) -> Ref: ...
    def entries(self, value: Any, *, id: str | None = ...) -> Ref: ...
    def from_entries(self, entries: Any, *, id: str | None = ...) -> Ref: ...
    def sha256(self, text: Any, *, id: str | None = ...) -> Ref: ...
    def canonical_json(self, value: Any, *, id: str | None = ...) -> Ref: ...
    def contains(self, value: Any, needle: Any, *, id: str | None = ...) -> Ref: ...
    def starts_with(self, text: Any, prefix: Any, *, id: str | None = ...) -> Ref: ...
    def ends_with(self, text: Any, suffix: Any, *, id: str | None = ...) -> Ref: ...
    def case(self, text: Any, mode: Literal['lower','upper'], *, id: str | None = ...) -> Ref: ...
    def lines(self, text: Any, *, number_from: int = ..., id: str | None = ...) -> Ref: ...
    def coalesce(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def flatten(self, values: Any, *, id: str | None = ...) -> Ref: ...
    def unique_by(self, values: Any, fields: list[str], *, id: str | None = ...) -> Ref: ...
    def range(self, start: Any, end: Any, step: Any = ..., *, id: str | None = ...) -> Ref: ...
    def index_of(self, values: Any, needle: Any, *, match: Literal['equal','contains'] = ..., id: str | None = ...) -> Ref: ...

class _Window(TypedDict, total=False):
    title: str
    by: str
    accent: str
    layout: Literal['banner', 'sidebar']
    masthead: list[str]

class _File:
    def walk(self, root: str | Ref, path: str | Ref | None = ..., *,
             ext: str | Ref | None = ..., max_entries: int | Ref | None = ...,
             max_depth: int | Ref | None = ..., id: str | None = ...) -> Ref: ...

class Ritual:
    data: _Data
    file: _File
    def __init__(self, name: str, *, description: str = ..., model: str | None = ...,
                 settings: dict[str, Any] | None = ..., essence: dict[str, Any] | None = ...,
                 reagents: dict[str, Any] | None = ..., requires: list[dict[str, Any]] | None = ...,
                 bindings: dict[str, Any] | None = ..., drift: dict[str, Any] | None = ...,
                 window: _Window | None = ...) -> None: ...
    def input(self, name: str, type: Type = ..., *, default: Any = ..., user_only: bool = ...) -> Ref: ...
    def op(self, tool: str, *, id: str | None = ..., verify: dict[str, Any] | None = ..., hold: Any = ..., **arguments: Any) -> Ref: ...
    def model(self, *, prompt: Any, instructions: str | None = ..., returns: Type | dict[str, Any] | None = ...,
              id: str | None = ..., name: str | None = ..., settings: dict[str, Any] | None = ...,
              bind: list[str] | None = ..., abstain_if: Expr | Callable[[Ref], Expr] | None = ...,
              one_of: list[str] | None = ..., choose: Ref | None = ...) -> Ref: ...
    def call(self, name: str, *, id: str | None = ..., version: int | None = ..., hash: str | None = ..., **arguments: Any) -> Ref: ...
    def ref(self, id: str) -> Ref: ...
    def param(self, name: str) -> Ref: ...
    def require(self, reagent: str, action: str, *, on: dict[str, Any] | None = ...,
                into: dict[str, Any] | None = ...) -> Ritual: ...
    def status(self, id: str) -> Ref: ...
    def cleanup(self) -> ContextManager[None]: ...
    def when(self, condition: Expr) -> ContextManager[None]: ...
    def each(self, values: Ref, *, id: str | None = ..., as_: str = ..., on_failure: str | None = ...,
             keep: list[str] | None = ...) -> ContextManager[Ref]: ...
    def fail_if(self, condition: Expr, message: str, *, id: str | None = ...) -> None: ...
    def map(self, values: Any, operation: str, arguments: dict[str, Any] | Callable[[Ref], dict[str, Any]], *, id: str | None = ...) -> Ref: ...
    def filter(self, values: Any, predicate: Expr | Callable[[Ref], Expr], *, params: dict[str, Any] | None = ..., id: str | None = ...) -> Ref: ...
    def fold(self, values: Any, initial: Any, operation: str, arguments: dict[str, Any] | Callable[[Ref, Ref], dict[str, Any]], *, id: str | None = ...) -> Ref: ...
    def returns(self, fields: dict[str, Any], *, schema: Type | dict[str, Any] | None = ...) -> Ritual: ...
    def definition(self) -> dict[str, Any]: ...
    def emit(self, stream: TextIO | None = ...) -> None: ...

def emit(ritual: Ritual, stream: TextIO | None = ...) -> None: ...
